{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexDeck",
  "version": "../package.json",
  "identifier": "com.codexdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexDeck",
        "width": 1080,
        "height": 760,
        "minWidth": 620,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Codex usage across isolated accounts",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/codexdeck-v2.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
